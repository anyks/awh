/**
 * Экранируем повторную инициализацию модуля
 */
#pragma once

/**
 * Подключаем заголовочный файл модуля
 */
#include <alloc/link.hpp>

/**
 * Используем стандартное пространство имён
 */
using namespace std;

/**
 * Пространство имён фреймворка
 */
namespace awh {
	/**
	 * Пространство имён распределителя памяти
	 */
	namespace alloc {
		/**
		 * @brief Метод перемешивания указателя
		 *
		 * @note Перемешивание парное: тот же вызов и мешает, и разбирает обратно
		 *
		 * @param block блок, хранящий указатель
		 * @param value перемешиваемый указатель
		 * @return      перемешанный указатель
		 *
		 */
		AWH_LINK_INLINE void * link_t::mangle(const void * block, void * value) noexcept {
			/**
			 * Признак AWH_ALLOC_NO_MANGLE снимает заслон списка свободных блоков
			 *
			 * Снявший его теряет обнаружение порчи списка: записанный в свободный
			 * блок чужой адрес уводит следующую выдачу куда укажет пишущий
			 *
			 * Выгода АРХИТЕКТУРНО ЗАВИСИМА и мала: у x86-64 около пяти процентов,
			 * у ARM64 её нет вовсе - там три команды перемешивания прячутся в тени
			 * обращений к памяти. Умолчание - заслон включён
			 */
			#if defined(AWH_ALLOC_NO_MANGLE)
				// Обходим перемешивание: блок к делу не идёт
				(void) block;
				// Выводим указатель как есть
				return value;
			#endif
			// Получаем место хранения указателя
			const uintptr_t pos = reinterpret_cast <uintptr_t> (block);
			// Собираем маску блока: зерно нечётное, оттого умножение обратимо и разрядов не теряет
			const uintptr_t mask = (((pos >> 4) * link_t::_cookie) ^ link_t::_cookie);
			// Выводим перемешанный указатель
			return reinterpret_cast <void *> (reinterpret_cast <uintptr_t> (value) ^ mask);
		}
		/**
		 * @brief Метод чтения указателя на следующий свободный блок
		 *
		 * @param block читаемый свободный блок
		 * @return      следующий свободный блок
		 *
		 */
		AWH_LINK_INLINE void * link_t::next(void * block) noexcept {
			// Хранимое значение
			void * result = nullptr;
			/**
			 * Читаем значение побайтовым копированием
			 *
			 * Копированием, а не приведением вида: выданная память выровнена лишь по
			 * шестнадцати байтам, а приведение к указателю на указатель обещало бы
			 * компилятору выравнивание, которого мы не обещали
			 */
			::memcpy(&result, block, sizeof(void *));
			// Выводим разобранный указатель
			return link_t::mangle(block, result);
		}
		/**
		 * @brief Метод записи указателя на следующий свободный блок
		 *
		 * @param block      изменяемый свободный блок
		 * @param subsequent записываемый следующий свободный блок
		 *
		 */
		AWH_LINK_INLINE void link_t::next(void * block, void * subsequent) noexcept {
			// Получаем перемешанное значение
			void * value = link_t::mangle(block, subsequent);
			// Записываем значение побайтовым копированием
			::memcpy(block, &value, sizeof(void *));
		}
	};
};
