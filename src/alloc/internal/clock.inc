 *
 */

/**
 * Экранируем повторную инициализацию модуля
 */
#pragma once

/**
 * Подключаем заголовочные файлы системы
 */
#if defined(_WIN32) || defined(_WIN64)
	/**
	 * Подключаем заголовочный файл проекта
	 */
	#include "../../../include/sys/macro/win32.hpp"
#endif

/**
 * Стандартные заголовочные файлы
 */
#include <ctime>
#include <chrono>
#include <cstdint>

/**
 * Заголовочные файлы дешёвых часов по системам
 */
#if defined(__FreeBSD__)
	/**
	 * Системный заголовочный файл
	 */
	#include <sys/sysctl.h>
#endif

/**
 * Заголовочный файл дешёвых часов Solaris
 */
#if defined(__sun__)
	/**
	 * Системный заголовочный файл
	 */
	#include <sys/time.h>
#endif

/**
 * Подключаем заголовочный файл проекта
 */
#include "../../../include/sys/macro/global.hpp"

/**
 * Используем стандартное пространство имён
 */
using namespace std;

/**
 * Пространство имён фреймворка
 */
namespace awh {
	/**
	 * Пространство имён распределителя памяти
	 */
	namespace alloc {
		/**
		 * @brief Пространство имён быстрых часов распределителя
		 *
		 */
		namespace clock {
			/**
			 * Реализация под Solaris или OpenIndiana
			 */
			#if defined(__sun__)
				/**
				 * @brief Функция получения текущего штампа времени в миллисекундах
				 *
				 * @note Огрублённых часов здесь нет, зато есть источник дешевле точных:
				 *       gethrtime отдаёт монотонные наносекунды числом и к ядру не
				 *       обращается вовсе - 21.8 и 22.4 наносекунды против 28.2 и 28.6
				 *       у clock_gettime, и вдобавок без сборки наносекунд из полей
				 *       структуры
				 *
				 * @return текущее время в миллисекундах
				 *
				 */
				static __AWH_INLINE__ uint64_t milliseconds() noexcept {
					// Выводим текущее время монотонных часов в миллисекундах
					return (static_cast <uint64_t> (::gethrtime()) / 1000000ULL);
				}
			/**
			 * Операционной системой является Linux
			 */
			#elif defined(__linux__)
				/**
				 * @brief Функция выбора источника монотонного времени
				 *
				 * @details Помимо точных монотонных часов у Linux есть дешёвые: они не
				 *          опрашивают счётчик тактов, а отдают значение, обновляемое ядром
				 *          раз в такт системного таймера. Зернистость их при частоте в
				 *          тысячу тактов - миллисекунда, и часы, отдающие миллисекунды,
				 *          ничего не теряют. Но при пониженной частоте шаг вырастает до
				 *          десятков миллисекунд и обесценил бы окно наблюдения, поэтому
				 *          частота проверяется, а не предполагается.
				 *
				 * @note Частота настройкой ядра не читается: имени вроде «kern.hz» у
				 *       Linux нет, а sysconf(_SC_CLK_TCK) отдаёт не частоту ядра, а
				 *       постоянную величину сопряжения в сотню. Оттого шаг дешёвых часов
				 *       замеряется напрямую тем же средством, которым потом и читается
				 *
				 * @return идентификатор источника монотонного времени
				 *
				 */
				static __AWH_INLINE__ clockid_t monotonic() noexcept {
					// Шаг дешёвых монотонных часов
					struct timespec resolution{};
					// Если шаг дешёвых часов получен и не превышает миллисекунды
					if((::clock_getres(CLOCK_MONOTONIC_COARSE, &resolution) == 0) &&
					  ((resolution.tv_sec == 0) && (resolution.tv_nsec <= 1000000L)))
						// Выбираем дешёвый источник монотонного времени
						return CLOCK_MONOTONIC_COARSE;
					// Выбираем точный источник монотонного времени
					return CLOCK_MONOTONIC;
				}

				/**
				 * Идентификатор источника монотонного времени, выбирается однажды
				 */
				static const clockid_t source = monotonic();

				/**
				 * @brief Функция получения текущего штампа времени в миллисекундах
				 *
				 * @return текущее время в миллисекундах
				 *
				 */
				static __AWH_INLINE__ uint64_t milliseconds() noexcept {
					// Объект структуры для хранения времени
					struct timespec ts{};
					// Получаем текущее время монотонных часов
					::clock_gettime(source, &ts);
					// Выводим текущее время в миллисекундах
					return ((static_cast <uint64_t> (ts.tv_sec) * 1000ULL) + (static_cast <uint64_t> (ts.tv_nsec) / 1000000ULL));
				}
			/**
			 * Операционной системой является MS Windows
			 */
			#elif defined(_WIN32) || defined(_WIN64)
				/**
				 * Если набором команд является ARM64
				 */
				#if defined(__aarch64__) || defined(_M_ARM64)
					/**
					 * @brief Функция получения частоты счётчика системного таймера ARM
					 *
					 * @details Счётчик читается из пространства пользователя без перехода
					 *          в ядро: на стенде Windows 11 ARM64 чтение cntvct_el0 стоит
					 *          0.23 наносекунды против 15.04 у QueryPerformanceCounter и
					 *          21.19 у clock_gettime - источник у всех один, cntfrq_el0 и
					 *          QueryPerformanceFrequency отдают одну частоту в 24 МГц.
					 *
					 * @note Частота спрашивается однажды и проверяется, а не предполагается:
					 *       встречное устройство вправе оставить регистр незаполненным, и
					 *       деление на ноль обошлось бы дороже отступления к часам языка
					 *
					 * @return частота счётчика в тактах за секунду либо ноль при негодности
					 *
					 */
					static __AWH_INLINE__ uint64_t frequency() noexcept {
						// Частота счётчика системного таймера
						uint64_t result = 0;
						/**
						 * @brief Если компилятор принадлежит к Visual Studio
						 *
						 * @note Вставок на языке машины оснастка MSVC под ARM64 не принимает,
						 *       и регистры читаются посредником. CNTFRQ_EL0 есть
						 *       (op0=3, op1=3, CRn=14, CRm=0, op2=0)
						 *
						 */
						#if defined(_MSC_VER)
							// Читаем частоту счётчика системного таймера
							result = ::_ReadStatusReg(ARM64_SYSREG(3, 3, 14, 0, 0));
						/**
						 * Если компилятор принадлежит к MinGW
						 */
						#else
							// Читаем частоту счётчика системного таймера
							__asm__ volatile("mrs %0, cntfrq_el0" : "=r" (result));
						#endif
						// Выводим частоту счётчика, признав негодной невозможную
						return ((result >= 1000000ULL) ? result : 0);
					}

					/**
					 * Частота счётчика системного таймера, ноль означает негодность
					 */
					static const uint64_t counter = frequency();

					/**
					 * @brief Функция получения текущего показания счётчика системного таймера ARM
					 *
					 * @return текущее показание счётчика в тактах
					 *
					 */
					static __AWH_INLINE__ uint64_t ticks() noexcept {
						// Текущее показание счётчика системного таймера
						uint64_t result = 0;
						/**
						 * Если компилятор принадлежит к Visual Studio
						 *
						 * @note CNTVCT_EL0 есть (op0=3, op1=3, CRn=14, CRm=0, op2=2)
						 *
						 */
						#if defined(_MSC_VER)
							// Читаем показание счётчика системного таймера
							result = ::_ReadStatusReg(ARM64_SYSREG(3, 3, 14, 0, 2));
						/**
						 * Если компилятор принадлежит к MinGW
						 */
						#else
							// Читаем показание счётчика системного таймера
							__asm__ volatile("mrs %0, cntvct_el0" : "=r" (result) :: "memory");
						#endif
						// Выводим текущее показание счётчика
						return result;
					}
					/**
					 * @brief Функция приведения показания счётчика к заданной доле секунды
					 *
					 * @details Счёт ведётся раздельно по целым секундам и остатку намеренно:
					 *          прямое умножение тактов на тысячу переполняет разрядность
					 *          спустя время работы при частоте счётчика в 24 МГц, и время
					 *          пошло бы вспять.
					 *
					 * @param value показание счётчика в тактах
					 * @param scale количество долей секунды в единице вывода
					 * @return      время в заданных долях секунды
					 *
					 */
					static __AWH_INLINE__ uint64_t convert(const uint64_t value, const uint64_t scale) noexcept {
						// Выводим время, сложенное из целых секунд и остатка
						return (((value / counter) * scale) + (((value % counter) * scale) / counter));
					}
				#endif
				/**
				 * @brief Функция получения текущего штампа времени в миллисекундах
				 *
				 * @note Дешёвые часы MS Windows (GetTickCount64) не годятся, хотя и стоят
				 *       0.67 наносекунды: зернистость их 16 миллисекунд, тогда как функция
				 *       отдаёт миллисекунды, и окно наблюдения округлялось бы до шестнадцати
				 *
				 * @return текущее время в миллисекундах
				 *
				 */
				static __AWH_INLINE__ uint64_t milliseconds() noexcept {
					/**
					 * Если набором команд является ARM64 и счётчик годен
					 */
					#if defined(__aarch64__) || defined(_M_ARM64)
						// Если счётчик системного таймера годен
						if(counter > 0)
							// Выводим текущее показание счётчика в миллисекундах
							return convert(ticks(), 1000ULL);
					#endif
					// Выводим текущее время монотонных часов языка в миллисекундах
					return static_cast <uint64_t> (chrono::duration_cast <chrono::milliseconds> (chrono::steady_clock::now().time_since_epoch()).count());
				}
			/**
			 * Операционной системой является macOS, FreeBSD, NetBSD, OpenBSD, DragonFly
			 */
			#elif defined(__APPLE__) || defined(__MACH__) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(__DragonFly__)
				/**
				 * Если операционной системой является FreeBSD
				 */
				#if defined(__FreeBSD__)
					/**
					 * @brief Функция выбора источника монотонного времени
					 *
					 * @details У FreeBSD помимо точных монотонных часов есть дешёвые:
					 *          разница четырёхкратная - 11.9 наносекунды против 43.8, и это
					 *          предел возможного: прямое чтение счётчика тактов стоит те же
					 *          11.0. Зернистость дешёвых при частоте в тысячу тактов -
					 *          миллисекунда, и часы, отдающие миллисекунды, не теряют ничего;
					 *          при пониженной частоте шаг вырос бы и обесценил окно, поэтому
					 *          частота проверяется, а не предполагается.
					 *
					 * @return идентификатор источника монотонного времени
					 *
					 */
					static __AWH_INLINE__ clockid_t monotonic() noexcept {
						// Частота системного таймера
						int32_t hertz = 0;
						// Размер получаемого значения
						size_t length = sizeof(hertz);
						// Если частота получена и шаг дешёвых часов не превышает миллисекунды
						if((::sysctlbyname("kern.hz", &hertz, &length, nullptr, 0) == 0) && (hertz >= 1000))
							// Выбираем дешёвый источник монотонного времени
							return CLOCK_MONOTONIC_FAST;
						// Выбираем точный источник монотонного времени
						return CLOCK_MONOTONIC;
					}

					/**
					 * Идентификатор источника монотонного времени, выбирается однажды
					 */
					static const clockid_t source = monotonic();
				/**
				 * Если системой является NetBSD с набором команд ARM64
				 */
				#elif defined(__NetBSD__) && defined(__aarch64__)
					/**
					 * @brief Функция получения частоты счётчика системного таймера ARM
					 *
					 * @details У NetBSD быстрого пути к часам нет: всякий clock_gettime уходит
					 *          в ядро целиком и стоит 1647 наносекунд (стенд NetBSD 11.0 aarch64).
					 *          Счётчик системного таймера ARM читается из пространства
					 *          пользователя без обращения к ядру и стоит 0.5 наносекунды -
					 *          источник тот же, по нему ядро и считает монотонное время.
					 *
					 * @note Частота спрашивается однажды и проверяется, а не предполагается:
					 *       встречное устройство вправе оставить регистр незаполненным, и
					 *       деление на ноль обошлось бы дороже отступления к обращению в ядро
					 *
					 * @return частота счётчика в тактах за секунду либо ноль при негодности
					 *
					 */
					static __AWH_INLINE__ uint64_t frequency() noexcept {
						// Частота счётчика системного таймера
						uint64_t result = 0;
						// Читаем частоту счётчика системного таймера
						__asm__ volatile("mrs %0, cntfrq_el0" : "=r" (result));
						// Выводим частоту счётчика, признав негодной невозможную
						return ((result >= 1000000ULL) ? result : 0);
					}

					/**
					 * Частота счётчика системного таймера, ноль означает негодность
					 */
					static const uint64_t counter = frequency();

					/**
					 * @brief Функция получения текущего показания счётчика системного таймера ARM
					 *
					 * @return текущее показание счётчика в тактах
					 *
					 */
					static __AWH_INLINE__ uint64_t ticks() noexcept {
						// Текущее показание счётчика системного таймера
						uint64_t result = 0;
						// Читаем показание счётчика системного таймера
						__asm__ volatile("mrs %0, cntvct_el0" : "=r" (result) :: "memory");
						// Выводим текущее показание счётчика
						return result;
					}
					/**
					 * @brief Функция приведения показания счётчика к заданной доле секунды
					 *
					 * @details Счёт ведётся раздельно по целым секундам и остатку намеренно:
					 *          прямое умножение тактов на тысячу переполняет разрядность
					 *          спустя время работы, и время пошло бы вспять.
					 *
					 * @param value показание счётчика в тактах
					 * @param scale количество долей секунды в единице вывода
					 * @return      время в заданных долях секунды
					 *
					 */
					static __AWH_INLINE__ uint64_t convert(const uint64_t value, const uint64_t scale) noexcept {
						// Выводим время, сложенное из целых секунд и остатка
						return (((value / counter) * scale) + (((value % counter) * scale) / counter));
					}
				#endif
				/**
				 * @brief Функция получения текущего штампа времени в миллисекундах
				 *
				 * @return текущее время в миллисекундах
				 *
				 */
				static __AWH_INLINE__ uint64_t milliseconds() noexcept {
					/**
					 * @brief Если операционной системой является macOS
					 *
					 * @note Время берётся функцией, отдающей наносекунды числом, а не через
					 *       структуру: 13.0 наносекунды против 15.5 у clock_gettime. Дешёвые
					 *       часы CLOCK_MONOTONIC_RAW_APPROX стоят 3.7 наносекунды против 13.0
					 *       у точных; отсчёт у них тот же (считают время сна машины), а
					 *       постоянное смещение от точных сокращается при сверке окна
					 *
					 */
					#if defined(__APPLE__)
						/**
						 * Если дешёвые монотонные часы доступны
						 */
						#if defined(CLOCK_MONOTONIC_RAW_APPROX)
							// Выводим время дешёвых монотонных часов в миллисекундах
							return (::clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW_APPROX) / 1000000ULL);
						/**
						 * Если дешёвых монотонных часов нет
						 */
						#else
							// Выводим время монотонных часов в миллисекундах
							return (::clock_gettime_nsec_np(CLOCK_MONOTONIC) / 1000000ULL);
						#endif
					/**
					 * Если операционной системой является FreeBSD
					 */
					#elif defined(__FreeBSD__)
						// Объект структуры для хранения времени
						struct timespec ts{0};
						// Получаем текущее время монотонных часов
						::clock_gettime(source, &ts);
						// Выводим текущее время в миллисекундах
						return ((static_cast <uint64_t> (ts.tv_sec) * 1000ULL) + (static_cast <uint64_t> (ts.tv_nsec) / 1000000ULL));
					/**
					 * Если системой является NetBSD с набором команд ARM64
					 */
					#elif defined(__NetBSD__) && defined(__aarch64__)
						// Если счётчик системного таймера годен
						if(counter > 0)
							// Выводим текущее показание счётчика в миллисекундах
							return convert(ticks(), 1000ULL);
						// Объект структуры для хранения времени
						struct timespec ts{0};
						// Получаем текущее время монотонных часов
						::clock_gettime(CLOCK_MONOTONIC, &ts);
						// Выводим текущее время в миллисекундах
						return ((static_cast <uint64_t> (ts.tv_sec) * 1000ULL) + (static_cast <uint64_t> (ts.tv_nsec) / 1000000ULL));
					/**
					 * Если это другая операционная система семейства BSD
					 */
					#else
						// Объект структуры для хранения времени
						struct timespec ts{0};
						// Получаем текущее время монотонных часов
						::clock_gettime(CLOCK_MONOTONIC, &ts);
						// Выводим текущее время в миллисекундах
						return ((static_cast <uint64_t> (ts.tv_sec) * 1000ULL) + (static_cast <uint64_t> (ts.tv_nsec) / 1000000ULL));
					#endif
				}
			/**
			 * Если это иная операционная система
			 */
			#else
				/**
				 * @brief Функция получения текущего штампа времени в миллисекундах
				 *
				 * @return текущее время в миллисекундах
				 *
				 */
				static __AWH_INLINE__ uint64_t milliseconds() noexcept {
					// Выводим текущее время монотонных часов языка в миллисекундах
					return static_cast <uint64_t> (chrono::duration_cast <chrono::milliseconds> (chrono::steady_clock::now().time_since_epoch()).count());
				}
			#endif
		};
	};
};
