# Русскоязычная сборка документации
#
# Наследует все настройки основного файла Doxyfile и переопределяет
# лишь язык вывода и каталог назначения. Из многоязычных комментариев
# (\~russian / \~english) выбирается русская ветвь.

@INCLUDE = Doxyfile

OUTPUT_LANGUAGE  = Russian
OUTPUT_DIRECTORY = ./doc/ru
