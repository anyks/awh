# Каталог исключений индекса знаний (синтаксис .gitignore; правила .gitignore действуют по умолчанию)
# Сюда дописываются пути, которые не должны попадать в Workspace Index и Repo Wiki.

# Каталоги CMake-сборок (sanitizer/bench-варианты, не покрытые .gitignore)
/build-asan/
/build-bench/
/build-ubsan/

# Исходники сторонних подмодулей: они не часть AWH, это эталонные данные
# компрессоров, PCRE2 и BoringSSL для стендов сверки
/submodules/
