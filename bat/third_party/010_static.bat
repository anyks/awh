@echo off
rem ============================================================================
rem  Объединение зависимостей в один архив оснасткой Microsoft Visual Studio
rem
rem  Двойник merge_static_libs.sh для машин без MSYS2. Зовётся из
rem  build_third_party.bat после nghttp2 и ДО gperftools - порядок этот не вольный,
rem  причина его названа ниже, у списка исключений.
rem
rem  Средство у оснасток разное по существу, а не по имени. Архиватор POSIX
rem  принимает лишь объектные файлы, и потому подлинник разбирает чужие архивы,
rem  переименовывает одноимённые модули и собирает их заново. Здесь lib.exe
rem  принимает архивы напрямую и сливает их сам: разбор, переименование двойников
rem  и ranlib не нужны вовсе. Оттого двойник этот КОРОЧЕ подлинника, а не длиннее.
rem
rem  Исходные архивы остаются на месте, как и в подлиннике: сборка каждой
rem  зависимости помечена штампом, и повторный прогон пересобирает лишь
rem  изменившуюся. Слияние, съевшее прочие архивы, собрало бы итог только из
rem  свежих модулей, а прочее содержимое потерялось бы молча.
rem ============================================================================

setlocal enabledelayedexpansion

rem Итог объединения - единственное имя с приставкой lib во всём наборе
set "TARGET=%PREFIX%\lib\libdependence.lib"

rem Снос собранного
if /i "%~1"=="--clean" (
	if exist "%TARGET%" del /f /q "%TARGET%" > nul 2>&1
	exit /b 0
)

rem ----------------------------------------------------------------------------
rem  Библиотеки, объединению не подлежащие
rem
rem  Перечень тот же, что у merge_static_libs.sh, только имена названы без
rem  приставки lib: под MSVC архив зовётся целью сборки (common.lib), а под MinGW
rem  к ней добавляется приставка (libcommon.a). Сверяются оба написания, иначе
rem  ограждение работало бы лишь на одной оснастке.
rem
rem  Перехват выдачи памяти держится на том, что компоновщик берёт модуль
rem  перехвата ЦЕЛИКОМ; будучи же одним из множества модулей объединённой
rem  библиотеки, модуль берётся лишь при наличии неразрешённой метки. Эти архивы
rem  проект линкует напрямую (cmake/FindTcMalloc.cmake).
rem
rem  Вторая причина: слияние зовётся ДО сборки GPerfTools, поэтому при повторном
rem  прогоне штамп пропускает сборку аллокатора, и съеденные здесь архивы некому
rem  восстановить - линковка AWH встаёт на "cannot find tcmalloc_minimal.lib".
rem  Прочие архивы аллокатора не заказ проекта вовсе: в stacktrace.cc живёт
rem  ссылка на метки libunwind, которого в составе зависимостей нет.
rem
rem  Сам итог объединения входом себе служить не может: после прогона он остаётся
rem  в каталоге библиотек, и повторный прогон брал бы его наравне с модульными.
rem  Свои объектники удваивались, а устаревшие разрешали метки прежде свежих.
rem ----------------------------------------------------------------------------
set "EXCLUDES=dependence tcmalloc_minimal common tcmalloc tcmalloc_debug tcmalloc_minimal_debug profiler stacktrace symbolize low_level_alloc libbacktrace run_benchmark"

rem ----------------------------------------------------------------------------
rem  Сбор перечня объединяемых архивов
rem
rem  Импортные библиотеки разделяемых не берутся: они несут не код, а отсылки к
rem  нему, и слитые в общий архив отбирают имена у настоящего. Спутник опознаётся
rem  по соседнему .dll - в каталоге библиотек или в каталоге программ.
rem ----------------------------------------------------------------------------
set "PARTS="
set "COUNT=0"

for %%L in ("%PREFIX%\lib\*.lib") do (
	if exist "%%~fL" (
		set "SKIP=0"
		set "STEM=%%~nL"
		set "BARE=%%~nL"
		if /i "!BARE:~0,3!"=="lib" set "BARE=!BARE:~3!"
		for %%E in (%EXCLUDES%) do (
			if /i "!STEM!"=="%%E" set "SKIP=1"
			if /i "!BARE!"=="%%E" set "SKIP=1"
		)
		if exist "%PREFIX%\lib\%%~nL.dll" set "SKIP=1"
		if exist "%PREFIX%\bin\%%~nL.dll" set "SKIP=1"
		if "!SKIP!"=="0" (
			set "PARTS=!PARTS! "%%~fL""
			set /a COUNT+=1
			echo [AWH] static: merge %%~nxL
		) else (
			echo [AWH] static: skip %%~nxL
		)
	)
)

rem ----------------------------------------------------------------------------
rem  Объединять нечего
rem
rem  Итог при этом может стоять на месте с прошлого прогона - тогда он актуален,
rem  и отказывать нечем. Отказ уместен лишь тогда, когда итога нет вовсе.
rem ----------------------------------------------------------------------------
if "%COUNT%"=="0" (
	if exist "%TARGET%" (
		echo [AWH] static: nothing to merge, libdependence.lib is up to date
		exit /b 0
	)
	echo [AWH] static: no dependencies to merge were found in %PREFIX%\lib
	exit /b 1
)

rem ----------------------------------------------------------------------------
rem  Предупреждение о снимаемом итоге
rem
rem  Источники остаются на месте, но на ногах, где их прежде уже разобрали, в
rem  каталоге библиотек лежит один libdependence со всем содержимым - и если к
rem  нему подходит свежий архив одной зависимости, новый состав соберётся только
rem  из неё. Молча это делать нельзя: отказ пришёл бы лишь на линковке приложения
rem  отсутствием меток, которых в перечне выше просто нет.
rem ----------------------------------------------------------------------------
if exist "%TARGET%" (
	echo [AWH] static: WARNING - прежний libdependence.lib снимается; в новый состав вошли только архивы, перечисленные выше
	echo [AWH] static: WARNING - если часть зависимостей уже была разобрана прежним слиянием, соберите зависимости целиком (--rebuild)
)

rem ----------------------------------------------------------------------------
rem  Объединение
rem
rem  Итог пишется во ВРЕМЕННЫЙ файл и лишь затем занимает место цели: прерванный
rem  на полпути архиватор оставил бы рваный архив на месте годного.
rem
rem  Пачки по длине командной строки здесь не нужны: архивов десяток, а не тысячи
rem  модулей, и предел строки в 32 КиБ им не грозит.
rem ----------------------------------------------------------------------------
set "MERGED=%TARGET%.merged"

if exist "%MERGED%" del /f /q "%MERGED%" > nul 2>&1

lib.exe /nologo /out:"%MERGED%" %PARTS%
if errorlevel 1 (
	echo [AWH] static: merging failed
	if exist "%MERGED%" del /f /q "%MERGED%" > nul 2>&1
	exit /b 1
)

move /y "%MERGED%" "%TARGET%" > nul
if errorlevel 1 (
	echo [AWH] static: could not replace "%TARGET%"
	exit /b 1
)

echo [AWH] static: merged %COUNT% libraries into libdependence.lib
exit /b 0