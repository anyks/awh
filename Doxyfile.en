# Англоязычная сборка документации
#
# Наследует все настройки основного файла Doxyfile и переопределяет
# лишь язык вывода и каталог назначения. Из многоязычных комментариев
# (\~russian / \~english) выбирается английская ветвь.

@INCLUDE = Doxyfile

OUTPUT_LANGUAGE  = English
OUTPUT_DIRECTORY = ./doc/en
